# Copia aquest fitxer a .env.local i omple-ho amb la config web de Firebase
# (Consola Firebase → Configuració del projecte → Les teves apps → App web).
# Aquests valors NO són secrets: van al navegador igualment. La seguretat la donen les firestore.rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=totem-of-happiness.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=totem-of-happiness
VITE_FIREBASE_APP_ID=

# Edició activa (any de l'esdeveniment)
VITE_EDITION_ID=2027
